# Copy this file to .env.local and fill in the values.
# Endpoint URLs come from your eSignet discovery document:
#   https://<esignet-host>/.well-known/openid-configuration

# --- eSignet login (sent to the browser) ---
NEXT_PUBLIC_ESIGNET_AUTHORIZE_URL=https://<esignet-host>/authorize
NEXT_PUBLIC_ESIGNET_CLIENT_ID=<your-client-id>
NEXT_PUBLIC_ESIGNET_REDIRECT_URI=http://localhost:3001/redirect
NEXT_PUBLIC_ESIGNET_SCOPE=openid profile email
NEXT_PUBLIC_ESIGNET_UI_LOCALES=en

# --- eSignet backend (server only) ---
ESIGNET_TOKEN_URL=https://<esignet-host>/<token_endpoint path>
ESIGNET_USERINFO_URL=https://<esignet-host>/<userinfo_endpoint path>
ESIGNET_JWKS_URL=https://<esignet-host>/.well-known/jwks.json
ESIGNET_ISSUER=https://<esignet-host>
# Optional: `aud` of the client_assertion. Defaults to ESIGNET_TOKEN_URL.
ESIGNET_CLIENT_ASSERTION_AUDIENCE=
# Private key (single-line JWK JSON or PEM) whose public key is registered on your eSignet client.
# Keep it secret: never commit it or expose it to the browser.
ESIGNET_CLIENT_PRIVATE_KEY=

# --- Wallet login (optional) ---
# Set to true to show "Login with Wallet". Defaults to false.
NEXT_PUBLIC_ENABLE_WALLET_LOGIN=false
# Server only; required when wallet login is enabled
CREDISSUER_PRESENTATION_URL=
CREDISSUER_RESPONSE_URI_PREFIX=
CREDISSUER_VERIFIER_ORIGIN=
